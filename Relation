package Config_DataBase;
import java.util.*;
import java.nio.*;
import java.nio.charset.StandardCharsets;

public class Relation {
    private String nom;
    private int nbCol;
    private List<ColumnInfo> colonnes;

    public Relation(String nom) {
        this.nom = nom;
        this.nbCol = 0;
        this.colonnes = new ArrayList<>();
    }

    public void addColonne(String nom, String type, int taille) {
        colonnes.add(new ColumnInfo(nom, type, taille));
        nbCol++;
    }

    public void removeColonne(String nom) {
        boolean found = false;
        Iterator<ColumnInfo> it = colonnes.iterator();
        while (it.hasNext()&&!found) {
            ColumnInfo c = it.next();
            if (c.getNom().equals(nom)) {
                it.remove();
                nbCol--;
                found=true;

            }
        }
        if (!found)
            System.out.println("ERREUR : colonne inexistante");
    }

    public void writeRecordToBuffer(Record record, ByteBuffer buff, int pos) {
        buff.position(pos);
        for (int i = 0; i < nbCol; i++) {
            ColumnInfo col = colonnes.get(i);
            String value = record.getValeurs().get(i);

            switch (col.getType()) {
                case "INT":
                    buff.putInt(Integer.parseInt(value));
                    break;

                case "FLOAT":
                    buff.putFloat(Float.parseFloat(value));
                    break;

                case "CHAR":
                    byte[] strBytes = value.getBytes(StandardCharsets.UTF_8);
                    int len = Math.min(strBytes.length, col.getTaille());
                    buff.put(strBytes, 0, len);
                    for (int j = len; j < col.getTaille(); j++)
                        buff.put((byte) 0); //Padding
                    break;

                case "VARCHAR":
                    byte[] varBytes = value.getBytes(StandardCharsets.UTF_8);
                    int length = Math.min(varBytes.length, col.getTaille());
                    buff.putInt(length); // longueur réelle
                    buff.put(varBytes, 0, length);
                    for (int j = length; j < col.getTaille(); j++)
                        buff.put((byte) 0); // padding facultatif
                    break;

                default:
                    throw new IllegalArgumentException("Type non supporté : " + col.getType());
            }
        }
    }

    public void readFromBuffer(Record record, ByteBuffer buff, int pos) {
        buff.position(pos);
        for (ColumnInfo col : colonnes) {
            switch (col.getType()) {
                case "INT":
                    record.addValue(String.valueOf(buff.getInt()));
                    break;

                case "FLOAT":
                    record.addValue(String.valueOf(buff.getFloat()));
                    break;

                case "CHAR":
                    byte[] charBytes = new byte[col.getTaille()];
                    buff.get(charBytes);
                    record.addValue(new String(charBytes, StandardCharsets.UTF_8).trim());
                    break;

                case "VARCHAR":
                    int length = buff.getInt();
                    byte[] varBytes = new byte[col.getTaille()];
                    buff.get(varBytes);
                    record.addValue(new String(varBytes, 0, length, StandardCharsets.UTF_8));
                    break;

                default:
                    throw new IllegalArgumentException("Type non supporté : " + col.getType());
            }
        }
    }
}

